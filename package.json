{
  "name": "@kernelonpanic/kitcode",
  "version": "1.2.4",
  "description": "Terminal coding agent with a config you never have to write by hand",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/KernelEditor/KitCode#readme",
  "bugs": {
    "url": "https://github.com/KernelEditor/KitCode/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KernelEditor/KitCode.git"
  },
  "bin": {
    "kitcode": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "tsup",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "openai": "^7.3.0",
    "react": "^19.2.8",
    "string-width": "^8.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "keywords": [
    "cli",
    "coding-agent",
    "ai",
    "terminal",
    "anthropic",
    "openai",
    "mcp"
  ]
}
